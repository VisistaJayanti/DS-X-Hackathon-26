# Coverage Keeper: API keys and settings.
#
# Copy this file to .env (git-ignored) and fill in YOUR OWN keys there:
#   Windows PowerShell:  Copy-Item .env.example .env
#   macOS / Linux:       cp .env.example .env
# Never put real keys in this file: .env.example is committed to git.
# Variables already set in your system environment take precedence over .env.
# Any key you leave blank: that provider's stages fall back to the deterministic engine.

# Free API tiers used by the default "free" preset (keeper/config.py).
GROQ_API_KEY=          # https://console.groq.com/keys
GEMINI_API_KEY=        # https://aistudio.google.com/apikey
CEREBRAS_API_KEY=      # https://cloud.cerebras.ai

# NVIDIA NIM: all stages on open-weight models with ONE key (selects the "nvidia" preset automatically).
NVIDIA_API_KEY=        # https://build.nvidia.com  (sign in, then "Get API Key"; starts with nvapi-)

# Optional providers.
OPENROUTER_API_KEY=    # https://openrouter.ai/keys  (free models end in ":free")
ANTHROPIC_API_KEY=     # set this to switch to the Claude preset (paid)
PP_CUSTOM_BASE_URL=    # any other OpenAI-compatible endpoint, used with PP_MODEL_<STAGE>=custom:<model>
PP_CUSTOM_API_KEY=

# Optional settings.
# PP_MODELS=nvidia                        # nvidia | free | anthropic (default: anthropic key > nvidia key > free)
# PP_MODEL_EXTRACT=nvidia:nvidia/nemotron-3.5-lightning-30b-a3b   # faster, smaller extraction model
# PP_MODEL_DRAFT=openrouter:openai/gpt-oss-120b:free   # per-stage override, provider:model
# PP_MODE=live                            # live | replay | offline
